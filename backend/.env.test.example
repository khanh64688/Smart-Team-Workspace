# Cấu hình database dùng cho pytest.
#
# Chép file này thành backend/.env.test rồi chỉnh cho khớp máy của bạn:
#
#   cp backend/.env.test.example backend/.env.test
#
# conftest.py bắt buộc tên database phải kết thúc bằng "_test" để pytest
# không bao giờ xoá nhầm database phát triển (mỗi phiên test đều chạy
# DROP SCHEMA public CASCADE).
#
# Tạo database test một lần, dùng chính container db của docker compose:
#
#   docker compose up -d db
#   docker compose exec db psql -U twl -d postgres \
#       -c "CREATE DATABASE smart_team_workspace_test"
#
# User/password mặc định lấy theo POSTGRES_USER / POSTGRES_PASSWORD trong
# docker-compose.yml. Nếu volume postgres_data của bạn được khởi tạo từ
# trước với bộ credentials khác thì sửa lại chuỗi bên dưới cho đúng.
TEST_DATABASE_URL=postgresql+psycopg://twl:twlpass@localhost:5432/smart_team_workspace_test
