# cp .env.example .env
# Mọi biến đã có mặc định trong docker-compose.yml, chỉ tạo .env khi cần đổi.

POSTGRES_USER=twl
POSTGRES_PASSWORD=twlpass
POSTGRES_DB=smart_team_db
POSTGRES_PORT=5432

# Chạy bằng Docker thì bỏ trống, compose tự ghép từ 3 biến trên.
# Chỉ điền khi chạy backend ngoài Docker (host là localhost, không phải db).
# Driver là psycopg 3 — viết `postgresql+psycopg://`, KHÔNG phải `psycopg2`.
DATABASE_URL=

SECRET_KEY=dev_secret_key_change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

APP_ENV=development
API_V1_PREFIX=/api/v1

# Origin của frontend, ngăn cách bởi dấu phẩy. Chạy qua docker-compose thì
# frontend đi bằng nginx proxy (same-origin) nên không cần, chỉ dùng khi chạy
# `npm run dev` trỏ thẳng sang backend ở cổng 8000.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# gemini | openai — bỏ trống AI_API_KEY thì tính năng AI báo "chưa cấu hình".
AI_PROVIDER=gemini
AI_API_KEY=

# Free tier tính quota riêng cho TỪNG model theo ngày. gemini-3.6-flash chỉ
# được 20 request/ngày, hết rất nhanh vì mỗi câu hỏi tốn 2 lượt gọi.
# Hết quota thì đổi sang model khác: gemini-3.5-flash, gemini-3.6-flash.
# gemini-2.5-flash đã ngừng cấp cho key mới.
AI_MODEL=gemini-3.1-flash-lite

# Chỉ cần khi chạy frontend ngoài Docker. Trong compose, nginx đã proxy /api.
VITE_API_URL=http://localhost:8000/api/v1
