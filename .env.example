# cp .env.example .env
# Mọi biến đã có mặc định trong docker-compose.yml, chỉ tạo .env khi cần đổi.

POSTGRES_USER=stw
POSTGRES_PASSWORD=stw
POSTGRES_DB=stw

# Chạy bằng Docker thì bỏ trống, compose tự ghép từ 3 biến trên.
# Chỉ điền khi chạy backend ngoài Docker (host là localhost, không phải db).
# Driver là psycopg 3 — viết `postgresql+psycopg://`, KHÔNG phải `psycopg2`.
DATABASE_URL=

SECRET_KEY=doi-secret-nay-truoc-khi-deploy
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

APP_ENV=development
API_V1_PREFIX=/api/v1

# gemini | openai — bỏ trống AI_API_KEY thì tính năng AI báo "chưa cấu hình".
AI_PROVIDER=gemini
AI_API_KEY=

VITE_API_URL=http://localhost:8000

# Đổi khi cổng mặc định đã bị chiếm.
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
