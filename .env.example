# =============================================================
#  Smart Team Workspace — mẫu biến môi trường
# =============================================================
#  Cách dùng:   cp .env.example .env
#
#  File này CHỈ chứa giá trị mặc định cho môi trường phát triển.
#  Không điền khoá thật vào đây — .env.example được commit lên Git.
#
#  Mọi biến dưới đây đều đã có giá trị mặc định trong docker-compose.yml,
#  nên `docker compose up` vẫn chạy được cả khi bạn chưa tạo .env.
#  Tạo .env khi bạn cần đổi cổng hoặc dùng tính năng AI.
# =============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=stw
POSTGRES_PASSWORD=stw
POSTGRES_DB=stw

# ---------- Backend ----------
# Host `db` là tên service trong docker-compose, không phải localhost.
# Nếu đổi POSTGRES_USER/PASSWORD/DB ở trên thì phải sửa lại chuỗi này cho khớp.
DATABASE_URL=postgresql+psycopg2://stw:stw@db:5432/stw

# Khoá ký JWT. Sinh khoá thật cho môi trường deploy:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-khoa-nay-truoc-khi-deploy

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- AI Sprint Summary ----------
# gemini | openai
AI_PROVIDER=gemini
# Bỏ trống thì tính năng AI trả về thông báo "chưa cấu hình" thay vì lỗi.
# Khoá này CHỈ được dùng ở backend, không bao giờ đưa xuống frontend.
AI_API_KEY=

# ---------- Frontend ----------
# URL trình duyệt gọi tới backend (chạy trên máy host, nên là localhost).
VITE_API_URL=http://localhost:8000

# ---------- Cổng trên máy host ----------
# Đổi ở đây nếu cổng mặc định đã bị chương trình khác chiếm.
# Ví dụ máy bạn đã có PostgreSQL riêng: đặt POSTGRES_PORT=55432
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
